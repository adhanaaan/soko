# Where priority-list sign-ups are sent. Required in production.
# Paste the Google Apps Script web app URL (see docs/priority-list-setup.md),
# or any endpoint that accepts a JSON POST and returns {"ok": true}.
PRIORITY_LIST_WEBHOOK_URL=

# Shared secret sent with every sign-up so the endpoint can reject anything
# that did not come from this site. Use a long random string.
PRIORITY_LIST_WEBHOOK_SECRET=

# Public site URL, used for Open Graph and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
